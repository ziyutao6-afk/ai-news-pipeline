{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "OPENAI_API_KEY": "sk-your-openai-api-key",
    "OPENAI_MODEL": "gpt-4o-mini",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "X_API_ENABLED": "false",
    "MANUAL_X_POST_MODE": "true",
    "GENERATE_X_INTENT_LINK": "true",
    "USE_OPENAI_FOR_SCORING": "false",
    "USE_OPENAI_FOR_TWEET": "true",
    "LOCAL_SCORE_MIN": "70",
    "OPENAI_MAX_CANDIDATES": "3",
    "OPENAI_MAX_RETRIES": "1",
    "OPENAI_RETRY_ON_OVERLOAD": "false",
    "OPENAI_STOP_ON_SERVICE_UNAVAILABLE": "true",
    "X_TWEET_LANGUAGE": "en",
    "TELEGRAM_INCLUDE_CHINESE_BRIEF": "true",
    "ENGLISH_TWEET_BODY_MAX_CHARS": "220",
    "CHINESE_BRIEF_MAX_CHARS": "160",
    "ENABLE_TWEET_IMAGE": "true",
    "DEFAULT_TWEET_IMAGE_PATH": "assets/default-news.png",
    "TELEGRAM_ENABLED": "true",
    "TELEGRAM_REVIEW_MODE": "true",
    "TELEGRAM_BUTTON_BASE_URL": "http://127.0.0.1:7071/api",
    "TELEGRAM_BOT_USERNAME": "@your_bot_username",
    "TELEGRAM_BOT_TOKEN": "your-telegram-bot-token",
    "TELEGRAM_CHAT_ID": "your-telegram-chat-id",

    "TWITTER_API_KEY": "",
    "TWITTER_API_SECRET": "",
    "TWITTER_ACCESS_TOKEN": "",
    "TWITTER_ACCESS_TOKEN_SECRET": "",

    "AZURE_STORAGE_CONNECTION_STRING": "UseDevelopmentStorage=true",
    "STATE_CONTAINER_NAME": "news-auto-tweet-state",

    "DRY_RUN": "true",
    "MIN_SCORE": "80",
    "MIN_AI_IMPACT_SCORE": "7",
    "FALLBACK_TOP_N": "3",
    "FALLBACK_MIN_SCORE": "70",
    "MAX_TWEETS_PER_RUN": "3",
    "NEWS_MIN_SCORE": "80",
    "NEWS_BREAKING_SCORE": "90",
    "NEWS_DAILY_POST_LIMIT": "3",
    "NEWS_BREAKING_EXTRA_DAILY_LIMIT": "0",
    "NEWS_MAX_POSTS_PER_RUN": "3",
    "NEWS_MAX_CANDIDATES_PER_RUN": "20",
    "NEWS_MAX_ARTICLE_AGE_HOURS": "48",

    "NEWS_RSS_FEEDS": "AI News|MIT Technology Review AI|https://www.technologyreview.com/topic/artificial-intelligence/feed;AI News|VentureBeat AI|https://venturebeat.com/category/ai/feed;Crypto News|CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/;Crypto News|Cointelegraph|https://cointelegraph.com/rss;Web3 News|Decrypt|https://decrypt.co/feed;Web3 News|The Defiant|https://thedefiant.io/feed;Policy / Regulation|Reuters Regulatory News|https://www.reutersagency.com/feed/?best-topics=regulatory-news&post_type=best;Policy / Regulation|SEC Press Releases|https://www.sec.gov/news/pressreleases.rss;Market Risk|Federal Reserve Press Releases|https://www.federalreserve.gov/feeds/press_all.xml",

    "ENABLE_LEGACY_RELEASE_FUNCTIONS": "false",
    "AzureWebJobs.ReleaseNotifier.Disabled": "true",
    "AzureWebJobs.SdkReleaseNotifier.Disabled": "true",
    "AzureWebJobs.VSCodeInsidersChangelogTweet.Disabled": "true",
    "AzureWebJobs.WeeklyCliRecap.Disabled": "true",
    "AzureWebJobs.VSCodeWeeklyRecap.Disabled": "true",
